# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Admin two-step verification (email OTP)
# ---------------------------------------------------------------------------
# The email address that receives the 6-digit admin verification code.
ADMIN_EMAIL="11xxajayxx11@gmail.com"

# The admin login password (change this! defaults to "admin123" when unset).
ADMIN_PASSWORD="change-me-please"

# SMTP settings used to deliver the verification code.
# Gmail example: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", SMTP_PASS=<app password>
# Leave SMTP_PASS blank to run in DEV mode (the code is printed to the server console
# and shown on screen so you can still log in while testing).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="11xxajayxx11@gmail.com"
SMTP_PASS=""

# Optional custom "From" header. Defaults to SMTP_USER when blank.
MAIL_FROM=""
